<!doctype html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio</title>
  </head>

  <body>

    <!-- Navbar Start -->
    <nav class="navbar fixed-top shadow-sm navbar-expand-lg bg-light navbar-light py-3 py-lg-0 px-lg-5">
      <a href="index.html" class="navbar-brand ms-lg-3">
        <h2 class="m-0 display-5">
          <span class="text-primary">Free</span>Folio
        </h2>
      </a>
      <button
        type="button"
        class="navbar-toggler"
        data-bs-toggle="collapse"
        data-bs-target="#navbarCollapse"
        aria-controls="navbarCollapse"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse px-lg-3" id="navbarCollapse">
        <div class="navbar-nav m-auto py-0">
          <a href="#home" class="nav-item nav-link active">Home</a>
          <% if (summary.length || contact.length) { %>
          <a href="#about" class="nav-item nav-link">About</a>
          <% } %>
          <% if (education.length || experience.length || certifications.length || training.length) { %>
          <a href="#qualification" class="nav-item nav-link">Quality</a>
          <% } %>
          <% if (skills.some(column => column.length)) { %>
          <a href="#skill" class="nav-item nav-link">Skill</a>
          <% } %>
          <% if (projects.length) { %>
          <a href="#portfolio" class="nav-item nav-link">Portfolio</a>
          <% } %>
          <% if (testimonials.length) { %>
          <a href="#testimonial" class="nav-item nav-link">Review</a>
          <% } %>
        </div>
        <a href="mailto:alex5272372@gmail.com" class="btn btn-outline-primary d-none d-lg-block">Hire Me</a>
      </div>
    </nav>
    <!-- Navbar End -->

    <!-- Header Start -->
    <div
      class="container-fluid bg-primary d-flex align-items-center mb-5 py-5"
      id="home"
      style="min-height: 100vh;"
    >
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-5 px-5 ps-lg-0 pb-5 pb-lg-0">
            <img
              class="img-fluid w-100 rounded-circle shadow-sm"
              src="img/profile.png"
              alt=""
            >
          </div>
          <div class="col-lg-7 text-center text-lg-start">
            <h3 class="text-white font-weight-normal mb-3">I'm</h3>
            <h2 class="display-3 text-uppercase text-primary mb-2" style="-webkit-text-stroke: 2px #ffffff;">
              Oleksii Nikolaienko
            </h2>
            <h2 class="typed-text-output d-inline font-weight-lighter text-white"></h2>
            <div class="typed-text d-none">
              Full Stack Developer, Web Developer, Front End Developer, Back End Developer, Apps Developer
            </div>
            <div class="d-flex align-items-center justify-content-center justify-content-lg-start pt-5">
              <a href="print-resume.html" class="btn btn-outline-light me-5" target="_blank" rel="noopener">Print Resume</a>
              <a href="https://youtu.be/aeawOYjh1BQ" class="btn-play">
                <span></span>
              </a>
              <h5 class="font-weight-normal text-white m-0 ms-4 d-none d-sm-block">Play Video</h5>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Header End -->

    <!-- About Start -->
    <% if (summary.length || contact.length) { %>
    <div class="container-fluid py-5" id="about">
      <div class="container">
        <div class="position-relative d-flex align-items-center justify-content-center">
          <h2 class="display-1 text-uppercase text-white" style="-webkit-text-stroke: 1px #dee2e6;">About</h2>
          <h2 class="position-absolute text-uppercase text-primary">About Me</h2>
        </div>
        <div class="row align-items-center">
          <div class="col-lg-5 pb-4 pb-lg-0">
            <img
              class="img-fluid rounded w-100"
              src="img/about.jpg"
              alt=""
            >
          </div>
          <div class="col-lg-7">
            <% if (summary.length) { %>
            <h3 class="mb-4"><%= summary[0].title %></h3>
            <p><%= summary[0].description %></p>
            <% } %>
            <% if (contact.length) { %>
            <div class="row mb-3">
              <% contact.forEach(item => { %>
              <div class="col-sm-6 py-2">
                <h6><%= item.type.replace(/([A-Z])/g, ' $1').replace(/^./, letter => letter.toUpperCase()) %>:
                  <% if (item.type === 'email') { %>
                  <a href="mailto:<%= item.value %>" class="text-secondary"><%= item.value %></a>
                  <% } else if (item.type === 'website' || item.type === 'linkedin') { %>
                  <a href="<%= item.value %>" class="text-secondary"><%= item.value %></a>
                  <% } else if (item.type === 'birthday') { %>
                  <span class="text-secondary"><%= formatDate(item.value) %></span>
                  <% } else { %>
                  <span class="text-secondary"><%= item.value %></span>
                  <% } %>
                </h6>
              </div>
              <% }) %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <% } %>
    <!-- About End -->

    <!-- Qualification Start -->
    <% if (education.length || experience.length || certifications.length || training.length) { %>
    <div class="container-fluid py-5" id="qualification">
      <div class="container">
        <div class="position-relative d-flex align-items-center justify-content-center">
          <h2 class="display-1 text-uppercase text-white" style="-webkit-text-stroke: 1px #dee2e6;">Quality</h2>
          <h2 class="position-absolute text-uppercase text-primary">Education & Experience</h2>
        </div>
        <div class="row align-items-center">
          <% if (education.length) { %>
          <%- include('templates/education.ejs') %>
          <% } %>
          <% if (experience.length) { %>
          <%- include('templates/experience.ejs') %>
          <% } %>
        </div>
        <% if (certifications.length) { %>
        <div class="row align-items-center mt-4">
          <%- include('templates/certifications.ejs') %>
        </div>
        <% } %>
        <% if (training.length) { %>
        <div class="row align-items-center mt-4">
          <%- include('templates/training.ejs') %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>
    <!-- Qualification End -->

    <!-- Skill Start -->
    <% if (skills.some(column => column.length)) { %>
    <div class="container-fluid py-5" id="skill">
      <div class="container">
        <div class="position-relative d-flex align-items-center justify-content-center">
          <h2 class="display-1 text-uppercase text-white" style="-webkit-text-stroke: 1px #dee2e6;">Skills</h2>
          <h2 class="position-absolute text-uppercase text-primary">My Skills</h2>
        </div>
        <%- include('templates/skills.ejs') %>
      </div>
    </div>
    <% } %>
    <!-- Skill End -->

    <!-- Portfolio Start -->
    <% if (projects.length) { %>
    <div class="container-fluid pt-5 pb-3" id="portfolio">
      <div class="container">
        <div class="position-relative d-flex align-items-center justify-content-center">
          <h2 class="display-1 text-uppercase text-white" style="-webkit-text-stroke: 1px #dee2e6;">Gallery</h2>
          <h2 class="position-absolute text-uppercase text-primary">My Projects</h2>
        </div>
        <div class="row portfolio-container">
          <%- include('templates/projects.ejs') %>
        </div>
      </div>
    </div>
    <% } %>
    <!-- Portfolio End -->

    <!-- Testimonial Start -->
    <% if (testimonials.length) { %>
    <div class="container-fluid py-5" id="testimonial">
      <div class="container">
        <div class="position-relative d-flex align-items-center justify-content-center">
          <h2 class="display-1 text-uppercase text-white" style="-webkit-text-stroke: 1px #dee2e6;">Review</h2>
          <h2 class="position-absolute text-uppercase text-primary">People Say</h2>
        </div>
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="owl-carousel testimonial-carousel">
              <%- include('templates/testimonials.ejs') %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>
    <!-- Testimonial End -->

    <!-- Footer Start -->
    <div class="container-fluid bg-primary text-white mt-5 py-5 px-sm-3 px-md-5">
      <div class="container text-center py-5">
        <div class="d-flex justify-content-center mb-4">
          <a class="btn btn-light btn-social me-2" href="https://github.com/alex5272372">
            <i class="fab fa-github"></i>
          </a>
          <a class="btn btn-light btn-social me-2" href="https://www.linkedin.com/in/oleksii-nikolaienko-563255101/">
            <i class="fab fa-linkedin-in"></i>
          </a>
          <a class="btn btn-light btn-social" href="https://www.facebook.com/alex5272372/">
            <i class="fab fa-facebook-f"></i>
          </a>
        </div>
        <p class="m-0">
          &copy; <a class="text-white font-weight-bold" href="#">alex5272372.github.io</a>. All Rights Reserved.
          Designed by <a class="text-white font-weight-bold" href="https://htmlcodex.com">HTML Codex</a>
        </p>
      </div>
    </div>
    <!-- Footer End -->

    <!-- Scroll to Bottom -->
    <i class="fa fa-2x fa-angle-down text-white scroll-to-bottom"></i>

    <!-- Back to Top -->
    <a href="#" class="btn btn-outline-dark px-0 back-to-top">
      <i class="fa fa-angle-double-up"></i>
    </a>

  </body>
</html>
