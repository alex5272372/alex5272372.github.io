<div class="col-lg-6">
  <h3 class="mb-4">Training</h3>
  <div class="border-start border-primary pt-2 ps-4 ms-2">
    <% training.forEach(item => { %>
    <div class="position-relative mb-4">
      <i class="far fa-dot-circle text-primary position-absolute" style="top: 2px; left: -32px;"></i>
      <h5 class="font-weight-bold mb-1"><%= item.title %></h5>
      <% if (item.institution || item.startDate || item.endDate) { %>
      <p class="mb-2">
        <% if (item.institution) { %><strong><%= item.institution %></strong><% } %>
        <% if (item.startDate || item.endDate) { %><% if (item.institution) { %>| <% } %><small><%= formatDate(item.startDate) %><% if (item.endDate && item.endDate !== item.startDate) { %> - <%= formatDate(item.endDate) %><% } %></small><% } %>
      </p>
      <% } %>
      <% if (item.description) { %>
      <p><%= item.description %></p>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>
