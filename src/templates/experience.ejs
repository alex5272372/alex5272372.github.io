<div class="col-lg-6">
  <h3 class="mb-4">My Expericence</h3>
  <div class="border-start border-primary pt-2 ps-4 ms-2">
    <% experience.forEach(item => { %>
    <div class="position-relative mb-4">
      <i class="far fa-dot-circle text-primary position-absolute" style="top: 2px; left: -32px;"></i>
      <h5 class="font-weight-bold mb-1"><%= item.title %></h5>
      <p class="mb-2">
        <strong>
          <% if (item.url) { %>
          <a href="<%= item.url %>"><%= item.company %></a>
          <% } else { %>
          <%= item.company %>
          <% } %>
        </strong>
        <% if (item.startDate || item.endDate) { %>| <small><%= formatDate(item.startDate) %><% if (item.endDate && item.endDate !== item.startDate) { %> - <%= formatDate(item.endDate) %><% } else if (item.ongoing) { %> - Present<% } %></small><% } %>
      </p>
      <% if (item.responsibilities.length) { %>
      <ul>
        <% item.responsibilities.forEach(responsibility => { %>
        <li><%= responsibility %></li>
        <% }) %>
      </ul>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>