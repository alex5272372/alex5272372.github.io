<% projects.forEach(project => { %>
<div class="col-lg-4 col-md-6 mb-4 portfolio-item <%= project.category %>">
  <div class="position-relative overflow-hidden mb-2">
    <img
      class="img-fluid border rounded w-100"
      src="<%= project.image %>"
      alt=""
    >
    <div class="portfolio-btn bg-primary d-flex align-items-stretch">
      <a
        href="<%= project.url %>"
        data-lightbox="portfolio"
        aria-label="View <%= project.name %> project"
        class="flex-grow-1 d-flex align-items-center justify-content-center text-decoration-none"
      >
        <i class="fa fa-plus text-white" style="font-size: 60px;"></i>
      </a>
    </div>
  </div>
</div>
<% }) %>